{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reboot package database entry",
  "description": "Each data/packages/<oem>.yaml file is a list of these entries. reboot/db.py is the enforcing validator; tests keep this file in sync with it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "oem", "label", "tier", "why", "consequences", "sources", "confidence", "reviewed"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$"
    },
    "oem": { "type": "string", "minLength": 1, "description": "Must equal the file name without .yaml" },
    "label": { "type": "string", "minLength": 1 },
    "tier": { "enum": ["keep", "optional", "advanced"] },
    "why": { "type": "string", "minLength": 1 },
    "consequences": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(https?://|device:)" }
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "protected": { "type": "boolean", "description": "If true, tier must be keep" },
    "android_min": { "type": "integer", "minimum": 1, "description": "Android release major version" },
    "android_max": { "type": "integer", "minimum": 1 }
  }
}
